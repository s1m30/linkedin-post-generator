# Gemini API Key (obtain from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Brave Search API Key (obtain from https://brave.com/search/api/)
BRAVE_API_KEY=your_brave_api_key_here

# Database Configuration (SQLite for local dev; a Postgres/Supabase URL in prod)
DATABASE_URL=sqlite:///./linkedin_gen.db

# Server Configuration
HOST=127.0.0.1
PORT=8000

# Supabase Auth (Google sign-in) - from Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Set exactly one of these depending on your Supabase project's JWT signing method
# (Project Settings > API > JWT Settings). Legacy projects use a shared secret (HS256);
# newer projects sign with an asymmetric key, verified via the JWKS URL instead.
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=

# Bcrypt hash of your shared invite passphrase (never put the raw phrase here).
# Generate with: python -c "from passlib.hash import bcrypt; print(bcrypt.hash('your passphrase'))"
APP_PASSPHRASE_HASH=

# Comma-separated list of origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
